version: '3.8'

networks:
  app-network-dev:
    external: true
  app-network-prod:
    external: true

services:
  # MySQL Development
  mysql-dev:
    image: mysql:8.0
    container_name: mysql-dev
    restart: unless-stopped
    networks:
      - app-network-dev
    environment:
      MYSQL_ROOT_PASSWORD: {{ mysql_root_password_dev }}
      MYSQL_DATABASE: {{ mysql_database_dev }}
      MYSQL_USER: {{ mysql_user_dev }}
      MYSQL_PASSWORD: {{ mysql_password_dev }}
    volumes:
      - /opt/apps/mysql-dev:/var/lib/mysql
    ports:
      - "127.0.0.1:3306:3306"
    command: --default-authentication-plugin=mysql_native_password
  
  # MySQL Production
  mysql-prod:
    image: mysql:8.0
    container_name: mysql-prod
    restart: unless-stopped
    networks:
      - app-network-prod
    environment:
      MYSQL_ROOT_PASSWORD: {{ mysql_root_password_prod }}
      MYSQL_DATABASE: {{ mysql_database_prod }}
      MYSQL_USER: {{ mysql_user_prod }}
      MYSQL_PASSWORD: {{ mysql_password_prod }}
    volumes:
      - /opt/apps/mysql-prod:/var/lib/mysql
    ports:
      - "127.0.0.1:3307:3306"
    command: --default-authentication-plugin=mysql_native_password
  
  # Frontend Development
  frontend-dev:
    image: {{ docker_registry }}/{{ github_username }}/{{ frontend_image_name }}:dev
    container_name: frontend-dev
    restart: unless-stopped
    networks:
      - app-network-dev
    environment:
      NODE_ENV: development
      PUBLIC_API_URL: https://{{ backend_dev_domain }}
    ports:
      - "127.0.0.1:3000:3000"
  
  # Frontend Production
  frontend-prod:
    image: {{ docker_registry }}/{{ github_username }}/{{ frontend_image_name }}:latest
    container_name: frontend-prod
    restart: unless-stopped
    networks:
      - app-network-prod
    environment:
      NODE_ENV: production
      PUBLIC_API_URL: https://{{ backend_prod_domain }}
    ports:
      - "127.0.0.1:3001:3000"
  
  # Backend Development
  backend-dev:
    image: {{ docker_registry }}/{{ github_username }}/{{ backend_image_name }}:dev
    container_name: backend-dev
    restart: unless-stopped
    networks:
      - app-network-dev
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:5000
      ConnectionStrings__DefaultConnection: "Server=mysql-dev;Port=3306;Database={{ mysql_database_dev }};Uid={{ mysql_user_dev }};Pwd={{ mysql_password_dev }};"
    ports:
      - "127.0.0.1:5000:5000"
    depends_on:
      - mysql-dev
  
  # Backend Production
  backend-prod:
    image: {{ docker_registry }}/{{ github_username }}/{{ backend_image_name }}:latest
    container_name: backend-prod
    restart: unless-stopped
    networks:
      - app-network-prod
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ASPNETCORE_URLS: http://+:5000
      ConnectionStrings__DefaultConnection: "Server=mysql-prod;Port=3306;Database={{ mysql_database_prod }};Uid={{ mysql_user_prod }};Pwd={{ mysql_password_prod }};"
    ports:
      - "127.0.0.1:5001:5000"
    depends_on:
      - mysql-prod